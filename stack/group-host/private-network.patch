+    let roots = reqwest::Certificate::from_pem_bundle(&pem).with_context(refused)?;
+    let add = reqwest::ClientBuilder::add_root_certificate;
+    let checked = roots.iter().cloned().fold(reqwest::Client::builder(), add);
+    if roots.is_empty() || checked.build().is_err() {
+        anyhow::bail!(refused());
+    }
+    *EXTRA_ROOTS.write().expect("not poisoned") = roots;
+    Ok(())
