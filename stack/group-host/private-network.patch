+/// The certificate authorities every client of the host's trusts beside
+/// the public ones: none, until [`trust`] names them.
+static EXTRA_ROOTS: std::sync::RwLock<Vec<reqwest::Certificate>> =
+    std::sync::RwLock::new(Vec::new());
+
+/// Has every client built from now on trust the certificate authorities
+/// in the PEM file `config` names, `EXTRA_CA_CERTS`, beside the public
+/// ones; refused unless it holds at least one, each a certificate.
+pub fn trust(config: &Config) -> anyhow::Result<()> {
+    let Some(path) = &config.extra_ca_certs else {
+        return Ok(());
+    };
+    let named = path.display();
+    let refused = || format!("EXTRA_CA_CERTS is no PEM file of certificates: {named}");
+    let pem = std::fs::read(path).with_context(refused)?;
+    let roots = reqwest::Certificate::from_pem_bundle(&pem).with_context(refused)?;
+    let add = reqwest::ClientBuilder::add_root_certificate;
+    let checked = roots.iter().cloned().fold(reqwest::Client::builder(), add);
+    if roots.is_empty() || checked.build().is_err() {
+        anyhow::bail!(refused());
+    }
+    *EXTRA_ROOTS.write().expect("not poisoned") = roots;
+    Ok(())
+}
